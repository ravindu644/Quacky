# if/elif/else, nested while with break/continue, inclusive and empty for
if 1 < 2 then
  typeln less
elif 1 == 2 then
  typeln eq
else
  typeln greater
fi
i = 0
while i < 3 do
  j = 0
  while j < 3 do
    j = j + 1
    if j == 2 then continue fi
    typeln i=$i j=$j
  done
  i = i + 1
done
for k in 1..3 do
  typeln k=$k
done
for k in 5..1 do
  typeln never
done
typeln for-empty-ok
n = 0
while true do
  if n == 2 then break fi
  typeln n=$n
  n = n + 1
done
