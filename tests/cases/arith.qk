# every integer rule from spec section 4.2
typeln ${9223372036854775807 + 1}
min = 0 - 9223372036854775807 - 1
typeln ${min / (0 - 1)}
typeln ${min % (0 - 1)}
typeln ${1 << 64}
typeln ${1 << (0 - 1)}
typeln ${(0 - 8) >> 1}
typeln ${7 / 2} ${7 % 2} ${2 * 3} ${10 - 4}
typeln ${(0 - 7) / 2} ${(0 - 7) % 2}
