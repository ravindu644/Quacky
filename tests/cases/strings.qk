# concat with coercion, ordering, cross-type equality, a refcount growth loop
typeln ${"n=" + 42}
typeln ${"b=" + true}
typeln ${"a" + "b" + "c"}
typeln ${"abc" < "abd"}
typeln ${"abc" < "ab"}
typeln ${1 == "1"}
typeln ${1 != "1"}
s = ""
i = 0
while i < 100 do
  s = s + "x"
  i = i + 1
done
typeln $s
